[Unit]
Description=pi4gpio - shared GPIO/SPI/I2C/UART access daemon for Raspberry Pi 4
After=network.target

[Service]
ExecStart=/usr/local/bin/pi4gpiod
# Create this unprivileged account during installation and grant only the
# hardware groups required by the enabled interfaces.
User=pi4gpio
Group=pi4gpio
SupplementaryGroups=gpio i2c spi dialout
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
Restart=on-failure
RestartSec=2
RuntimeDirectory=pi4gpio
RuntimeDirectoryMode=0770

[Install]
WantedBy=multi-user.target
